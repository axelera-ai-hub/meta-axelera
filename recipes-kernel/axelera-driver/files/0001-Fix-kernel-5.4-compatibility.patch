From: Axelera AI <support@axelera.ai>
Date: Thu, 5 Dec 2024 12:00:00 +0000
Subject: [PATCH] Fix kernel 5.4 compatibility issues

Fix compatibility with older kernel 5.4 by addressing:
1. PCI_STD_NUM_BARS not defined in kernel 5.4 - define it if missing
2. pci_aer_clear_nonfatal_status() not available in kernel 5.4 - use older API

Upstream-Status: Pending

Signed-off-by: Axelera AI <support@axelera.ai>
---
 metis-core.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/metis-core.c b/metis-core.c
index 1234567..abcdefg 100644
--- a/metis-core.c
+++ b/metis-core.c
@@ -743,6 +743,11 @@ static void axl_mask_all_aer_errors(struct pci_dev *pdev)

 	dev_info(&pdev->dev, "All AER errors masked\n");
 }
+
+/* PCI_STD_NUM_BARS not available in kernel < 5.7 */
+#if LINUX_VERSION_CODE < KERNEL_VERSION(5, 7, 0)
+#define PCI_STD_NUM_BARS 6
+#endif
 static void axl_aipu_get_memwindow_info(struct axl_pcie_aipu_dev *axldev,
 					struct pci_dev *pdev)
 {
@@ -801,7 +806,13 @@ static int axlaipu_pci_init(struct pci_dev *pdev,
 	u16 reg16, lnkctl2, lnksta;
 	u32 reg32, lnkcap;

+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 7, 0)
 	pci_aer_clear_nonfatal_status(pdev);
+#else
+	/* Use older API for kernel < 5.7 */
+	pci_cleanup_aer_uncorrect_error_status(pdev);
+#endif
+
 	err = pcim_enable_device(pdev);
 	if (err) {
 		dev_err(&pdev->dev, "pci_enable_device failed: %d\n", err);
@@ -1312,7 +1323,11 @@ static int axlaipu_pci_resume_slot(struct pci_dev *pdev)
 		result = PCI_ERS_RESULT_RECOVERED;
 	}

+#if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 7, 0)
 	pci_aer_clear_nonfatal_status(pdev);
+#else
+	pci_cleanup_aer_uncorrect_error_status(pdev);
+#endif

 	return result;
 }

--
2.34.1
